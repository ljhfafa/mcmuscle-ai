include README.md README_EN.md LICENSE CONTEST_DECLARATION.md MCP_INTEGRATION.md mcp-config.example.json
include *.command
recursive-include .agents *.md *.yaml *.py
recursive-include docs *.md
recursive-include examples *.json *.md
recursive-include scripts *.py
prune private
prune .codex
prune .venv

include .gitignore
recursive-include .github *.yml
